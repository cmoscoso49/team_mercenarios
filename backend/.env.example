# Copiar como .env y configurar valores reales
SECRET_KEY=django-insecure-cambia-esto-en-produccion-con-valor-aleatorio-largo
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Producción (PythonAnywhere) — descomentar y ajustar ---
# SECRET_KEY=genera-una-clave-aleatoria-de-minimo-50-caracteres
# DEBUG=False
# ALLOWED_HOSTS=mercenarios.pythonanywhere.com
# CORS_ALLOWED_ORIGINS=https://team-mercenarios.pages.dev,https://mercenarios.cl,https://www.mercenarios.cl
# CSRF_TRUSTED_ORIGINS=https://mercenarios.pythonanywhere.com,https://mercenarios.cl,https://www.mercenarios.cl
# ⚠️ Sin CORS_ALLOWED_ORIGINS el login falla silenciosamente desde Cloudflare Pages

# Integración futura Instagram — NO poner tokens reales en código
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Coopeuch — solo importación de archivos Excel/CSV descargados manualmente
# NUNCA guardar usuario ni contraseña del banco
