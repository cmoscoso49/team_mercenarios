# URL base de la API (solo necesaria en producción)
# En desarrollo local, el proxy de Vite redirige /api → localhost:8001 automáticamente
#
# Sin custom domain (Cloudflare Pages + PythonAnywhere free):
# VITE_API_BASE_URL=https://TU_USUARIO.pythonanywhere.com/api/v1
#
# Con custom domain (requiere CF Worker o PA Hacker plan):
# VITE_API_BASE_URL=https://api.mercenarios.cl/api/v1
